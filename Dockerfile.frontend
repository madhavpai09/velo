# Multi-stage build for frontend
# Stage 1: Builder
FROM node:20-alpine as builder

WORKDIR /app

COPY frontend/package*.json ./

RUN npm ci --only=production && \
    npm ci --save-dev @types/react @types/react-dom typescript vite @vitejs/plugin-react tailwindcss postcss autoprefixer

COPY frontend/ .

# Build the application
RUN npm run build

# Stage 2: Runtime (using nginx)
FROM nginx:alpine

# Create non-root user
RUN addgroup -g 101 -S nginx && adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -c "nginx user" -G nginx nginx

# Copy nginx configuration
COPY frontend/nginx.conf /etc/nginx/nginx.conf

# Copy built application
COPY --from=builder /app/dist /usr/share/nginx/html

# Create directory with correct permissions
RUN mkdir -p /var/cache/nginx && \
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run /var/log/nginx

USER nginx

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:80/index.html || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
