# ============================================
# Environment Configuration - EXAMPLE FILE
# Copy this file to .env and update values
# ============================================

# Application Environment
ENVIRONMENT=development

# Database Configuration
DB_USER=Mini_Uber_user
DB_PASSWORD=password
DB_NAME=Mini_Uber
DB_PORT=5432
DATABASE_URL=postgresql://Mini_Uber_user:password@localhost:5432/Mini_Uber

# API Configuration
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Logging
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8000"]

# API Port
API_PORT=8000
FRONTEND_PORT=5173

# Frontend Configuration
VITE_API_BASE=http://localhost:8000/api

# Optional: Sentry for Error Tracking
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Optional: Email Configuration for Notifications
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SENDER_EMAIL=

# Optional: External Service APIs
# OSRM_API_URL=http://router.project-osrm.org
# MAPS_API_KEY=

# Feature Flags
ENABLE_SCHOOL_POOL=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Security
ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_TIMEOUT=3600
